# Vercel Ignore File
# Files/folders to ignore during deployment

# Development
node_modules
.next

# Environment files (use Vercel environment variables instead)
.env.local
.env*.local

# Testing
coverage
*.test.js
*.spec.js

# Documentation
*.md
!README.md

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
